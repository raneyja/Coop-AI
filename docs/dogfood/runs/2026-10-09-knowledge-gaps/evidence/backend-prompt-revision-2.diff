+/** Filename leads use the topic's nouns, not question scaffolding. No repo/path assumptions. */
+export function knowledgeGapsFilenameQueries(userFocus?: string): string[] {
+  const topics = knowledgeGapsFocusTopics(userFocus);
+  const tokens = topics.flatMap(knowledgeGapsTopicContentTokens);
+  const aliases = /\bwork[-\s]?items?\b/i.test(topics.join(" ")) ? ["issue"] : [];
+  const stems = tokens.flatMap(token => {
+    if (/^(signing|signer|signed)$/.test(token)) return ["sign"];
+    if (/^(states|transitions)$/.test(token)) return [token.replace(/s$/, "")];
+    return [token];
+  }).filter(token => !token.includes("/") && !/^(validation|implementation)$/.test(token));
+  return [...new Set([...aliases, ...stems])].slice(0, 4);
 }
 
