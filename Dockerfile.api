# Railway builds the last stage of this dedicated file; its Dockerfile builder
# does not select a named target. The worker retains the full toolchain image.
FROM node:22.23.3-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN test "$(npm --version)" = "10.9.9" && npm ci --no-audit --no-fund
COPY tsconfig.backend.json ./
COPY src ./src
COPY scripts/admin-org.ts ./scripts/admin-org.ts
COPY scripts/local-demo-db-target.ts ./scripts/local-demo-db-target.ts
RUN npm run build:backend && npm run build:workers && npm run build:admin

FROM node:22.23.3-trixie-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM gcr.io/distroless/nodejs22-debian13:nonroot@sha256:ec2313763dd43931543bd03830466e0c409ce73a487e8d46f10db72d3b816c1c AS api
WORKDIR /app
COPY --from=dependencies --chown=65532:65532 /app/package.json /app/package-lock.json ./
COPY --from=dependencies --chown=65532:65532 /app/node_modules ./node_modules
COPY --from=build --chown=65532:65532 /app/dist ./dist
COPY --chown=65532:65532 migrations ./migrations
COPY --chown=65532:65532 scripts/run-migrations.mjs ./scripts/run-migrations.mjs
COPY --chown=65532:65532 src/server/databasePoolOptions.cjs ./src/server/databasePoolOptions.cjs
ENV NODE_ENV=production PORT=8787 HOME=/tmp JOBS_WORKERS=0
USER 65532:65532
EXPOSE 8787
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["dist/webhookServer.js"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
 CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
